{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blogger-pwa",
  "compatibility_date": "2026-05-10",
  "assets": {
    "directory": "bucket",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "www.the-raghavan.com/app/*",
      "zone_name": "the-raghavan.com"
    }
  ],
  "dev": {
    "port": 8080
  }
}
